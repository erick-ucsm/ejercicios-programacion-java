package laboratorio12;


import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

// ============================================================
// EJERCICIO: Estrategias de Descuento (Patrón Strategy)
// ============================================================

// 1. Interfaz Strategy
interface DescuentoStrategy {
    double calcularPrecioFinal(List<Producto> productos);
    String getNombre();
}

// Clase Producto (Representa un ítem en el carrito)
class Producto {
    private String nombre;
    private double precio;

    public Producto(String nombre, double precio) {
        this.nombre = nombre;
        this.precio = precio;
    }

    public String getNombre() { return nombre; }
    public double getPrecio() { return precio; }

    @Override
    public String toString() {
        return nombre + " (S/ " + precio + ")";
    }
}

// 2. Implementaciones Concretas de las Estrategias

// Estrategia 1: Sin Descuento
class SinDescuento implements DescuentoStrategy {
    @Override
    public double calcularPrecioFinal(List<Producto> productos) {
        double total = 0;
        for (Producto p : productos) {
            total += p.getPrecio();
        }
        return total;
    }

    @Override
    public String getNombre() { return "Sin Descuento"; }
}

// Estrategia 2: Descuento Fijo (10%)
class DescuentoFijo implements DescuentoStrategy {
    @Override
    public double calcularPrecioFinal(List<Producto> productos) {
        double total = 0;
        for (Producto p : productos) {
            total += p.getPrecio();
        }
        // Se aplica el 10% de descuento al total
        return total * 0.90;
    }

    @Override
    public String getNombre() { return "Descuento Fijo (10% en total)"; }
}

// Estrategia 3: Descuento Porcentual (2 productos iguales -> 30%)
class DescuentoPorcentual implements DescuentoStrategy {
    @Override
    public double calcularPrecioFinal(List<Producto> productos) {
        double total = 0;
        boolean descuentoAplicado = false;
        
        // Buscamos si hay al menos 2 productos con el mismo nombre
        List<String> nombresProcesados = new ArrayList<>();
        for (Producto p1 : productos) {
            if (!nombresProcesados.contains(p1.getNombre())) {
                int contador = 0;
                for (Producto p2 : productos) {
                    if (p1.getNombre().equals(p2.getNombre())) {
                        contador++;
                    }
                }
                if (contador >= 2) {
                    descuentoAplicado = true;
                }
                nombresProcesados.add(p1.getNombre());
            }
        }

        if (descuentoAplicado) {
            // Si hay 2 productos iguales, aplicamos 30% al total
            for (Producto p : productos) {
                total += p.getPrecio();
            }
            return total * 0.70;
        } else {
            // Si no hay 2 iguales, se cobra el total normal
            for (Producto p : productos) {
                total += p.getPrecio();
            }
            return total;
        }
    }

    @Override
    public String getNombre() { return "Descuento 30% (2 productos iguales)"; }
}

// Estrategia 4: Descuento Porcentual Acumulado (3 productos -> 50% al más bajo)
class DescuentoPorcentualAcumulado implements DescuentoStrategy {
    @Override
    public double calcularPrecioFinal(List<Producto> productos) {
        double total = 0;
        
        if (productos.size() >= 3) {
            // Encontrar el producto más barato
            double precioMasBajo = Double.MAX_VALUE;
            for (Producto p : productos) {
                if (p.getPrecio() < precioMasBajo) {
                    precioMasBajo = p.getPrecio();
                }
            }
            
            // Sumamos todos los precios
            for (Producto p : productos) {
                total += p.getPrecio();
            }
            
            // Aplicamos el 50% de descuento solo al producto más bajo
            double descuento = precioMasBajo * 0.50;
            return total - descuento;
        } else {
            // Si hay menos de 3 productos, no hay descuento
            for (Producto p : productos) {
                total += p.getPrecio();
            }
            return total;
        }
    }

    @Override
    public String getNombre() { return "Descuento Acumulado (50% al más barato de 3)"; }
}

// 3. El Contexto (Calculadora)
class CalculadoraDePrecios {
    private DescuentoStrategy estrategia;

    public void setEstrategia(DescuentoStrategy estrategia) {
        this.estrategia = estrategia;
    }

    public double calcularTotal(List<Producto> productos) {
        if (estrategia == null) {
            System.out.println("Error: Primero seleccione una estrategia.");
            return 0;
        }
        return estrategia.calcularPrecioFinal(productos);
    }
    
    public String getNombreEstrategiaActual() {
        return estrategia != null ? estrategia.getNombre() : "Ninguna";
    }
}

// 4. Clase Principal (Menú Interactivo)
public class ejercicio2 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        CalculadoraDePrecios calculadora = new CalculadoraDePrecios();
        
        // Creamos una lista de productos de prueba para simular un carrito
        List<Producto> carrito = new ArrayList<>();
        carrito.add(new Producto("Camisa", 50.0));
        carrito.add(new Producto("Pantalón", 80.0));
        carrito.add(new Producto("Camisa", 50.0)); // Producto repetido para probar la estrategia 3
        carrito.add(new Producto("Medias", 10.0)); // Producto barato para probar la estrategia 4

        int opcion = 0;
        
        System.out.println("=========================================");
        System.out.println("   SISTEMA DE DESCUENTOS (STRATEGY)");
        System.out.println("=========================================");
        System.out.println("Carrito de compras actual:");
        for (Producto p : carrito) {
            System.out.println(" - " + p);
        }
        System.out.println("=========================================");

        while (opcion != 5) {
            System.out.println("\nSeleccione una estrategia de descuento:");
            System.out.println("1. Sin Descuento");
            System.out.println("2. Descuento Fijo (10%)");
            System.out.println("3. Descuento Porcentual (30% por 2 productos iguales)");
            System.out.println("4. Descuento Acumulado (50% al más barato de 3 productos)");
            System.out.println("5. Salir");
            System.out.print("Opción: ");
            
            try {
                opcion = scanner.nextInt();
                
                switch (opcion) {
                    case 1:
                        calculadora.setEstrategia(new SinDescuento());
                        break;
                    case 2:
                        calculadora.setEstrategia(new DescuentoFijo());
                        break;
                    case 3:
                        calculadora.setEstrategia(new DescuentoPorcentual());
                        break;
                    case 4:
                        calculadora.setEstrategia(new DescuentoPorcentualAcumulado());
                        break;
                    case 5:
                        System.out.println("Saliendo del sistema... ¡Hasta luego!");
                        continue;
                    default:
                        System.out.println("Opción inválida. Intente de nuevo.");
                        continue;
                }
                
                // Mostrar resultado
                double totalOriginal = 0;
                for (Producto p : carrito) totalOriginal += p.getPrecio();
                
                double totalFinal = calculadora.calcularTotal(carrito);
                
                System.out.println("\n--- RESULTADO ---");
                System.out.println("Estrategia aplicada: " + calculadora.getNombreEstrategiaActual());
                System.out.println("Total original: S/ " + totalOriginal);
                System.out.println("Total a pagar:  S/ " + totalFinal);
                System.out.println("-----------------");
                
            } catch (Exception e) {
                System.out.println("Error: Por favor ingrese un número válido.");
                scanner.nextLine(); // Limpiar el buffer
                opcion = 0;
            }
        }
        scanner.close();
    }
}
