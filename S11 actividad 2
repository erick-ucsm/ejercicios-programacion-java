package prac11;

import java.util.ArrayList;
import java.util.List;

class Producto {
    private String nombre;
    private double precio;
    private int cantidad;

    public Producto(String nombre, double precio, int cantidad) {
        this.nombre = nombre;
        this.precio = precio;
        this.cantidad = cantidad;
    }

    public String getNombre() {
        return nombre;
    }

    public double getPrecio() {
        return precio;
    }

    public int getCantidad() {
        return cantidad;
    }

    public double getSubtotal() {
        return precio * cantidad;
    }
}

interface EstrategiaPromocion {
    double aplicar(List<Producto> productos);
    String getNombre();
}

class SinPromocion implements EstrategiaPromocion {
    @Override
    public double aplicar(List<Producto> productos) {
        double total = 0;
        for (Producto p : productos) {
            total += p.getSubtotal();
        }
        return total;
    }

    @Override
    public String getNombre() {
        return "Sin promoción";
    }
}

class PromocionPorcentaje implements EstrategiaPromocion {
    private double porcentaje;

    public PromocionPorcentaje(double porcentaje) {
        this.porcentaje = porcentaje;
    }

    @Override
    public double aplicar(List<Producto> productos) {
        double total = new SinPromocion().aplicar(productos);
        return total * (1 - porcentaje / 100);
    }

    @Override
    public String getNombre() {
        return "Descuento del " + porcentaje + "%";
    }
}

class PromocionDosPorUno implements EstrategiaPromocion {
    @Override
    public double aplicar(List<Producto> productos) {
        double total = 0;
        for (Producto p : productos) {
            int pagadas = p.getCantidad() / 2 + p.getCantidad() % 2;
            total += pagadas * p.getPrecio();
        }
        return total;
    }

    @Override
    public String getNombre() {
        return "2x1 en productos iguales";
    }
}

class PromocionMontoMinimo implements EstrategiaPromocion {
    private double minimo;
    private double descuento;

    public PromocionMontoMinimo(double minimo, double descuento) {
        this.minimo = minimo;
        this.descuento = descuento;
    }

    @Override
    public double aplicar(List<Producto> productos) {
        double total = new SinPromocion().aplicar(productos);
        return total >= minimo ? total - descuento : total;
    }

    @Override
    public String getNombre() {
        return "S/ " + descuento + " menos por compras desde S/ " + minimo;
    }
}

class CalculadoraPromociones {
    private EstrategiaPromocion estrategia;

    public void setEstrategia(EstrategiaPromocion estrategia) {
        this.estrategia = estrategia;
    }

    public double calcular(List<Producto> productos) {
        return estrategia.aplicar(productos);
    }

    public String getNombreEstrategia() {
        return estrategia.getNombre();
    }
}

public class Main2 {
    public static void main(String[] args) {
        List<Producto> carrito = new ArrayList<>();
        carrito.add(new Producto("Cuaderno", 8.50, 3));
        carrito.add(new Producto("Lapicero", 2.00, 4));
        carrito.add(new Producto("Mochila", 120.00, 1));

        System.out.println("Carrito:");
        for (Producto p : carrito) {
            System.out.printf("  %-10s x%d  S/ %.2f%n", p.getNombre(), p.getCantidad(), p.getSubtotal());
        }

        EstrategiaPromocion[] promociones = {
            new SinPromocion(),
            new PromocionPorcentaje(15),
            new PromocionDosPorUno(),
            new PromocionMontoMinimo(100, 20)
        };

        CalculadoraPromociones calculadora = new CalculadoraPromociones();
        System.out.println("\nTotales según la promoción:");
        for (EstrategiaPromocion promo : promociones) {
            calculadora.setEstrategia(promo);
            System.out.printf("  %-45s S/ %.2f%n", calculadora.getNombreEstrategia(), calculadora.calcular(carrito));
        }
    }
}
