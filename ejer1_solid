package laboratorio3;

public class ejercicio1 {

    public static void main(String[] args) {

        Empleado empleado = new Empleado(
            "Carlos",
            2500,
            "Sistemas"
        );

        CalculadorPago calculador = new CalculadorPago();

        double pago = calculador.calcularPagoMensual(empleado);

        System.out.println("Empleado: " + empleado.getNombre());
        System.out.println("Departamento: " + empleado.getDepartamento());
        System.out.println("Salario: S/ " + pago);
    }
}


// Clase que solamente almacena la información del empleado
class Empleado {

    private String nombre;
    private double salario;
    private String departamento;

    public Empleado(String nombre, double salario, String departamento) {
        this.nombre = nombre;
        this.salario = salario;
        this.departamento = departamento;
    }

    public String getNombre() {
        return nombre;
    }

    public double getSalario() {
        return salario;
    }

    public String getDepartamento() {
        return departamento;
    }
}


// Clase que solamente se encarga de calcular el pago
class CalculadorPago {

    public double calcularPagoMensual(Empleado empleado) {
        return empleado.getSalario();
    }
}
