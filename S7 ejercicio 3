package laboratorio7;

import java.io.*;
import java.util.*;

// MODELO
class Empleado implements Serializable {
    private int numero;
    private String nombre;
    private double sueldo;

    public Empleado(int numero, String nombre, double sueldo) {
        this.numero = numero;
        this.nombre = nombre;
        this.sueldo = sueldo;
    }

    public int getNumero() { return numero; }
    public String getNombre() { return nombre; }
    public double getSueldo() { return sueldo; }

    @Override
    public String toString() {
        return "Número: " + numero + ", Nombre: " + nombre + ", Sueldo: " + sueldo;
    }
}

// CONTROLADOR
class ControladorEmpleado {
    private List<Empleado> empleados;
    private final String ARCHIVO = "empleados.dat";

    public ControladorEmpleado() {
        this.empleados = new ArrayList<>();
        leerEmpleados();
    }

    public void leerEmpleados() {
        File file = new File(ARCHIVO);
        if (!file.exists()) {
            System.out.println("No hay archivo de empleados. Se creará uno nuevo.");
            return;
        }
        try (ObjectInputStream ois = new ObjectInputStream(new FileInputStream(file))) {
            empleados = (List<Empleado>) ois.readObject();
        } catch (FileNotFoundException e) {
            System.out.println("Archivo no encontrado.");
        } catch (IOException | ClassNotFoundException e) {
            System.out.println("Error al leer empleados: " + e.getMessage());
        }
    }

    public void guardarEmpleados() {
        try (ObjectOutputStream oos = new ObjectOutputStream(new FileOutputStream(ARCHIVO))) {
            oos.writeObject(empleados);
        } catch (IOException e) {
            System.out.println("Error al guardar empleados: " + e.getMessage());
        }
    }

    public void agregarEmpleado(int numero, String nombre, double sueldo) {
        // Verificar si ya existe el número
        for (Empleado e : empleados) {
            if (e.getNumero() == numero) {
                System.out.println("Ya existe un empleado con ese número.");
                return;
            }
        }
        empleados.add(new Empleado(numero, nombre, sueldo));
        guardarEmpleados();
        System.out.println("Empleado agregado exitosamente.");
    }

    public void listarEmpleados() {
        if (empleados.isEmpty()) {
            System.out.println("No hay empleados registrados.");
        } else {
            for (Empleado e : empleados) {
                System.out.println(e);
            }
        }
    }

    public void buscarEmpleado(int numero) {
        for (Empleado e : empleados) {
            if (e.getNumero() == numero) {
                System.out.println("Empleado encontrado: " + e);
                return;
            }
        }
        System.out.println("Empleado no encontrado.");
    }

    public void eliminarEmpleado(int numero) {
        boolean eliminado = empleados.removeIf(e -> e.getNumero() == numero);
        if (eliminado) {
            guardarEmpleados();
            System.out.println("Empleado eliminado.");
        } else {
            System.out.println("Empleado no encontrado.");
        }
    }
}

// VISTA (Main)
public class ejercicio3 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        ControladorEmpleado controlador = new ControladorEmpleado();
        int opcion;

        do {
            System.out.println("\n--- SISTEMA DE EMPLEADOS (MVC) ---");
            System.out.println("1. Listar Empleados");
            System.out.println("2. Agregar Empleado");
            System.out.println("3. Buscar Empleado por Número");
            System.out.println("4. Eliminar Empleado por Número");
            System.out.println("5. Salir");
            System.out.print("Seleccione opción: ");
            opcion = sc.nextInt();
            sc.nextLine();

            try {
                switch (opcion) {
                    case 1:
                        controlador.listarEmpleados();
                        break;
                    case 2:
                        System.out.print("Número: ");
                        int num = sc.nextInt();
                        sc.nextLine();
                        System.out.print("Nombre: ");
                        String nom = sc.nextLine();
                        System.out.print("Sueldo: ");
                        double suel = sc.nextDouble();
                        controlador.agregarEmpleado(num, nom, suel);
                        break;
                    case 3:
                        System.out.print("Número a buscar: ");
                        int numBuscar = sc.nextInt();
                        controlador.buscarEmpleado(numBuscar);
                        break;
                    case 4:
                        System.out.print("Número a eliminar: ");
                        int numEliminar = sc.nextInt();
                        controlador.eliminarEmpleado(numEliminar);
                        break;
                    case 5:
                        System.out.println("Saliendo...");
                        break;
                    default:
                        System.out.println("Opción inválida.");
                }
            } catch (InputMismatchException e) {
                System.out.println("Error: Ingrese un valor numérico válido.");
                sc.nextLine(); // Limpiar buffer
            }
        } while (opcion != 5);
        sc.close();
    }
}
