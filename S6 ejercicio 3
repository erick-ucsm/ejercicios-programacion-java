    static class Enemigo {
        private String nombre;
        private int salud, saludMax, nivel, danoBase;
        private String tipo;
        private double recompensaOro;

        public Enemigo(String nombre, int salud, int nivel, String tipo, int danoBase, double recompensaOro) {
            this.nombre = nombre;
            this.salud = salud;
            this.saludMax = salud;
            this.nivel = nivel;
            this.tipo = tipo;
            this.danoBase = danoBase;
            this.recompensaOro = recompensaOro;
        }
        public String getNombre() { return nombre; }
        public int getSalud() { return salud; }
        public int getSaludMax() { return saludMax; }
        public int getNivel() { return nivel; }
        public String getTipo() { return tipo; }
        public double getRecompensaOro() { return recompensaOro; }

        public boolean estaVivo() { return salud > 0; }
