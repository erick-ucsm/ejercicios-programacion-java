    // ==================== MODELO: CombateModelo ====================
    static class CombateModelo {
        private Jugador jugador;
        private List<Enemigo> enemigos;
        private int enemigoActual;

        public CombateModelo(Jugador jugador) {
            this.jugador = jugador;
            this.enemigos = new ArrayList<>();
            this.enemigoActual = 0;
            // 5 monstruos + Rey Demonio final
            enemigos.add(new Enemigo("Goblin", 30, 1, "Humanoide", 6, 50));
            enemigos.add(new Enemigo("Orco", 55, 2, "Humanoide", 10, 100));
            enemigos.add(new Enemigo("Troll", 80, 3, "Bestia", 14, 180));
            enemigos.add(new Enemigo("Vampiro", 110, 4, "No-Muerto", 18, 280));
            enemigos.add(new Enemigo("Dragón", 150, 5, "Bestia", 22, 400));
            enemigos.add(new Enemigo("Rey Demonio", 250, 10, "Demonio", 30, 1000));
        }

        public Jugador getJugador() { return jugador; }
        public List<Enemigo> getEnemigos() { return enemigos; }
        public Enemigo getEnemigoActual() {
            return (enemigoActual < enemigos.size()) ? enemigos.get(enemigoActual) : null;
        }
        public int getIndiceActual() { return enemigoActual; }
        public int getTotalEnemigos() { return enemigos.size(); }

        public boolean combateTerminado() {
            return !jugador.estaVivo() || enemigoActual >= enemigos.size();
        }

        public boolean esReyDemonio() {
            Enemigo e = getEnemigoActual();
            return e != null && e.getNombre().equalsIgnoreCase("Rey Demonio");
        }

        public String turnoJugador() {
            Enemigo e = getEnemigoActual();
            if (e == null || !e.estaVivo()) return "No hay enemigo al que atacar.";
            int dano = jugador.atacar();
            e.recibirDano(dano);
            StringBuilder sb = new StringBuilder();
            sb.append("⚔ ").append(jugador.getNombre()).append(" ataca a ")
              .append(e.getNombre()).append(" causando ").append(dano).append(" de daño.");
            if (!e.estaVivo()) {
                sb.append("\n✔ ¡").append(e.getNombre()).append(" derrotado!");
                jugador.agregarOro(e.getRecompensaOro());
                sb.append("\n💰 Ganas S/ ").append(String.format("%.2f", e.getRecompensaOro())).append(" de oro.");
                enemigoActual++;
                if (enemigoActual < enemigos.size()) {
                    jugador.subirNivel();
                    sb.append("\n⬆ ¡Subes al nivel ").append(jugador.getNivel())
                      .append("! HP restaurado a ").append(jugador.getSalud()).append(".");
                    sb.append("\n¡Aparece ").append(enemigos.get(enemigoActual).getNombre()).append("!");
                }
            }
            return sb.toString();
        }

        public String turnoEnemigo() {
            Enemigo e = getEnemigoActual();
            if (e == null || !e.estaVivo()) return "";
            int dano = e.atacar();
            jugador.recibirDano(dano);
            String s = "💥 " + e.getNombre() + " ataca a " + jugador.getNombre()
                     + " causando " + dano + " de daño.";
            if (!jugador.estaVivo())
                s += "\n✘ ¡" + jugador.getNombre() + " ha caído en combate!";
            return s;
        }

        public String usarObjetoJugador(Item item) {
            if (item == null) return "Ítem no válido.";
            if (item.getCantidad() <= 0) return "No quedan unidades de " + item.getNombre();
            int curado = jugador.usarObjeto(item);
            return "🧪 " + jugador.getNombre() + " usa " + item.getNombre()
                 + " y recupera " + curado + " HP.";
        }
    }

