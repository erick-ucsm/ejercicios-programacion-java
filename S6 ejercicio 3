    // ==================== MODELO: Item ====================
    static class Item {
        private String nombre;
        private int cantidad;
        private String tipo;          // "Arma" o "Poción"
        private String descripcion;
        private int poder;            // daño o curación
        private double precio;        // precio en tienda

        public Item(String nombre, int cantidad, String tipo, String descripcion, int poder, double precio) {
            this.nombre = nombre;
            this.cantidad = cantidad;
            this.tipo = tipo;
            this.descripcion = descripcion;
            this.poder = poder;
            this.precio = precio;
        }
        public String getNombre() { return nombre; }
        public int getCantidad() { return cantidad; }
        public String getTipo() { return tipo; }
        public String getDescripcion() { return descripcion; }
        public int getPoder() { return poder; }
        public double getPrecio() { return precio; }

        public void setCantidad(int cantidad) { this.cantidad = cantidad; }
        public void usarItem() { if (cantidad > 0) cantidad--; }

        @Override
        public String toString() {
            return nombre + " [" + tipo + "] x" + cantidad
                    + " (Poder: " + poder + " | Precio: S/ " + String.format("%.2f", precio) + ")";
        }
    }

    // ==================== MODELO: Jugador ====================
    static class Jugador {
        private String nombre;
        private int salud, saludMax, nivel;
        private double oro;
        private List<Item> inventario;
        private Item itemEquipado;

        public Jugador(String nombre, int salud, int nivel, double oro) {
            this.nombre = nombre;
            this.salud = salud;
            this.saludMax = salud;
            this.nivel = nivel;
            this.oro = oro;
            this.inventario = new ArrayList<>();
            this.itemEquipado = null;
        }
        public String getNombre() { return nombre; }
        public int getSalud() { return salud; }
        public int getSaludMax() { return saludMax; }
        public int getNivel() { return nivel; }
        public double getOro() { return oro; }
        public List<Item> getInventario() { return inventario; }
        public Item getItemEquipado() { return itemEquipado; }

        public void setNivel(int nivel) { this.nivel = nivel; }
        public void subirNivel() {
            this.nivel++;
            this.saludMax += 20;
            this.salud = this.saludMax; // se cura al subir de nivel
        }
        public void setOro(double oro) { this.oro = oro; }
        public void agregarOro(double monto) { this.oro += monto; }
        public void gastarOro(double monto) { this.oro -= monto; }

        public boolean estaVivo() { return salud > 0; }

        public void agregarItem(Item item) {
            // Si ya existe un item con el mismo nombre, incrementa cantidad
            for (Item i : inventario) {
                if (i.getNombre().equalsIgnoreCase(item.getNombre())) {
                    i.setCantidad(i.getCantidad() + item.getCantidad());
                    return;
                }
            }
            inventario.add(item);
        }

        public void equiparItem(Item item) {
            if (item != null && "Arma".equalsIgnoreCase(item.getTipo()))
                this.itemEquipado = item;
        }

        public int atacar() {
            return (itemEquipado != null) ? itemEquipado.getPoder() : 5;
        }

        public int usarObjeto(Item item) {
            if (item == null) return 0;
            if ("Poción".equalsIgnoreCase(item.getTipo()) && item.getCantidad() > 0) {
                int antes = this.salud;
                this.salud = Math.min(salud + item.getPoder(), saludMax);
                item.usarItem();
                return this.salud - antes;
            }
            return 0;
        }

        public void recibirDano(int dano) {
            this.salud = Math.max(0, salud - dano);
        }

        // Cuenta cuántos ítems de un tipo tiene (sumando cantidades)
        public int contarPorTipo(String tipo) {
            int c = 0;
            for (Item i : inventario)
                if (i.getTipo().equalsIgnoreCase(tipo)) c += i.getCantidad();
            return c;
        }

        // Cuenta cuántos ítems con un nombre específico tiene
        public int contarPorNombre(String nombre) {
            for (Item i : inventario)
                if (i.getNombre().equalsIgnoreCase(nombre)) return i.getCantidad();
            return 0;
        }
    }

