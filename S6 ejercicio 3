    // ==================== CONTROLADOR: TiendaController ====================
    static class TiendaController {
        private TiendaModelo modelo;
        private TiendaView vista;
        private Jugador jugador;

        public TiendaController(TiendaModelo m, TiendaView v, Jugador j) {
            this.modelo = m; this.vista = v; this.jugador = j;
        }

        public void abrirTienda() {
            String op;
            do {
                vista.mostrarMensaje("\n💰 Oro disponible: S/ " + String.format("%.2f", jugador.getOro()));
                vista.mostrarCatalogo(modelo.getCatalogo());
                int opcion = vista.solicitarEntero("Seleccione un ítem para comprar: ");

                if (opcion == modelo.getCatalogo().size() + 1 || opcion == -1) break;

                Item item = modelo.getItem(opcion);
                if (item == null) { vista.mostrarMensaje("Opción inválida."); continue; }

                // Validaciones
                if ("Arma".equalsIgnoreCase(item.getTipo())) {
                    if (jugador.contarPorNombre(item.getNombre()) >= 1) {
                        vista.mostrarMensaje("Ya tienes un/a " + item.getNombre() + " (solo 1 permitido).");
                        continue;
                    }
                } else if ("Poción".equalsIgnoreCase(item.getTipo())) {
                    if (jugador.contarPorNombre(item.getNombre()) >= 10) {
                        vista.mostrarMensaje("Límite alcanzado: 10 " + item.getNombre() + " máximo.");
                        continue;
                    }
                }

                if (jugador.getOro() < item.getPrecio()) {
                    vista.mostrarMensaje("✘ Oro insuficiente. Necesitas S/ "
                            + String.format("%.2f", item.getPrecio()));
                    continue;
                }

                // Compra
                jugador.gastarOro(item.getPrecio());
                jugador.agregarItem(new Item(item.getNombre(), 1, item.getTipo(),
                        item.getDescripcion(), item.getPoder(), item.getPrecio()));
                vista.mostrarMensaje("Has comprado: " + item.getNombre());

                // Autoequipar si es arma y no tiene ninguna
                if ("Arma".equalsIgnoreCase(item.getTipo()) && jugador.getItemEquipado() == null) {
                    for (Item i : jugador.getInventario())
                        if (i.getNombre().equalsIgnoreCase(item.getNombre())) {
                            jugador.equiparItem(i);
                            vista.mostrarMensaje("Arma equipada automáticamente.");
                            break;
                        }
                }

            } while (true);
        }
    }

    // ==================== CONTROLADOR: InventarioController ====================
    static class InventarioController {
        private InventarioView vista;
        private Jugador jugador;

        public InventarioController(InventarioView v, Jugador j) {
            this.vista = v; this.jugador = j;
        }

        public void menuInventario() {
            String op;
            do {
                System.out.println("\n========= INVENTARIO DEL JUGADOR =========");
                System.out.println("1. Mostrar inventario");
                System.out.println("2. Buscar ítem (ver detalle)");
                System.out.println("3. Volver al menú principal");
                System.out.println("==========================================");
                op = vista.solicitarTexto("Opción: ");
                switch (op) {
                    case "1":
                        vista.mostrarInventarioNumerado(jugador.getInventario());
                        break;
                    case "2":
                        buscarItem();
                        break;
                    case "3":
                        break;
                    default:
                        vista.mostrarMensaje("Opción inválida.");
                }
            } while (!op.equals("3"));
        }

        // Buscar ítem: muestra todos los ítems del jugador y permite seleccionar uno por número
        private void buscarItem() {
            List<Item> items = jugador.getInventario();
            if (items.isEmpty()) {
                vista.mostrarMensaje("No tienes ítems en el inventario.");
                return;
            }
            vista.mostrarInventarioNumerado(items);
            int op = vista.solicitarEntero("Seleccione el número del ítem para ver detalle: ");
            if (op >= 1 && op <= items.size()) {
                vista.mostrarDetalleItem(items.get(op - 1));
            } else {
                vista.mostrarMensaje("Número inválido.");
            }
        }
    }

    // ==================== CONTROLADOR: CombateController ====================
    static class CombateController {
        private CombateModelo modelo;
        private CombateView vista;

        public CombateController(CombateModelo m, CombateView v) {
            this.modelo = m; this.vista = v;
        }

        // Retorna true si el juego terminó completamente (Rey Demonio derrotado o jugador muerto)
        public boolean iniciar() {
            System.out.println("COMIENZA EL COMBATE");
            String opcion;
            do {
                if (modelo.combateTerminado()) break;
                vista.mostrarEstado(modelo.getJugador(), modelo.getEnemigoActual(),
                        modelo.getIndiceActual(), modelo.getTotalEnemigos());
                vista.mostrarMenuCombate();
                opcion = vista.solicitarOpcion();

                switch (opcion) {
                    case "1":
                        vista.mostrarMensaje(modelo.turnoJugador());
                        if (!modelo.combateTerminado()) {
                            vista.mostrarMensaje(modelo.turnoEnemigo());
                        }
                        break;
                    case "2":
                        usarPocion();
                        if (!modelo.combateTerminado()) {
                            vista.mostrarMensaje(modelo.turnoEnemigo());
                        }
                        break;
                    case "3":
                        cambiarArma();
                        break;
                    case "4":
                        vista.mostrarMensaje("Has huido del combate.");
                        return false;
                    default:
                        vista.mostrarMensaje("Opción inválida.");
                }
            } while (!opcion.equals("4"));

            // Resultado final
            System.out.println("\n===== RESULTADO FINAL =====");
            if (!modelo.getJugador().estaVivo()) {
                System.out.println("☠ DERROTA. El jugador ha caído en combate.");
                return true;
            }

            // Si llegó al final y ya no hay más enemigos
            if (modelo.getEnemigoActual() == null) {
                System.out.println("FELICIDADES! HAS DERROTADO AL REY DEMONIO");
                System.out.println("TERMINASTE EL JUEGO");
                return true;
            }
            return false;
        }

        // Cambiar arma: lista las armas del inventario y elige por número
        private void cambiarArma() {
            List<Item> armas = new ArrayList<>();
            for (Item i : modelo.getJugador().getInventario())
                if ("Arma".equalsIgnoreCase(i.getTipo()) && i.getCantidad() > 0)
                    armas.add(i);

            if (armas.isEmpty()) {
                vista.mostrarMensaje("No tienes armas en el inventario.");
                return;
            }

            System.out.println("\n--- ARMAS DISPONIBLES ---");
            for (int i = 0; i < armas.size(); i++)
                System.out.println((i + 1) + ". " + armas.get(i));
            int op = vista.solicitarEntero("Seleccione el arma a equipar: ");
            if (op >= 1 && op <= armas.size()) {
                modelo.getJugador().equiparItem(armas.get(op - 1));
                vista.mostrarMensaje("Arma equipada: " + armas.get(op - 1).getNombre());
            } else {
                vista.mostrarMensaje("Número inválido.");
            }
        }

        // Usar poción: lista las pociones del inventario y elige por número
        private void usarPocion() {
            List<Item> pociones = new ArrayList<>();
            for (Item i : modelo.getJugador().getInventario())
                if ("Poción".equalsIgnoreCase(i.getTipo()) && i.getCantidad() > 0)
                    pociones.add(i);

            if (pociones.isEmpty()) {
                vista.mostrarMensaje("No tienes pociones en el inventario.");
                return;
            }

            System.out.println("\n--- POCIONES DISPONIBLES ---");
            for (int i = 0; i < pociones.size(); i++)
                System.out.println((i + 1) + ". " + pociones.get(i));
            int op = vista.solicitarEntero("Seleccione la poción a consumir: ");
            if (op >= 1 && op <= pociones.size()) {
                vista.mostrarMensaje(modelo.usarObjetoJugador(pociones.get(op - 1)));
            } else {
                vista.mostrarMensaje("Número inválido.");
            }
        }
    }

