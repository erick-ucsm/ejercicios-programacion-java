            System.out.println("║ 1. Inventario                ║");
            System.out.println("║ 2. Comprar ítems (Tienda)    ║");
            System.out.println("║ 3. Iniciar Combate           ║");
            System.out.println("║ 4. Salir                     ║");
            System.out.println("╚══════════════════════════════╝");
            System.out.print("Opción: ");
            op = sc.nextLine();

            switch (op) {
                case "1":
                    inventarioController.menuInventario();
                    break;
                case "2":
                    tiendaController.abrirTienda();
                    break;
                case "3":
                    // Cada vez que inicia combate, se crea un nuevo CombateModelo
                    // para que empiece desde el primer enemigo (Nv.1)
                    CombateModelo combateModelo = new CombateModelo(jugador);
                    // Resetear nivel a 1 al iniciar una nueva partida de combate
                    jugador.setNivel(1);
                    CombateController combateController = new CombateController(combateModelo, combateView);
                    juegoTerminado = combateController.iniciar();
                    break;
                case "4":
                    System.out.println("Saliendo del juego...");
                    juegoTerminado = true;
                    break;
                default:
                    System.out.println("Opción inválida.");
            }
        } while (!juegoTerminado);

        sc.close();
        inventarioView.cerrar();
        tiendaView.cerrar();
        combateView.cerrar();
    }
}
