package laboratorio10;

import javax.swing.*;
import java.awt.*;

public class ejercicio2 {

    public static void main(String[] args) {

        JFrame frame = new JFrame("Registro de Temperaturas Semanales");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setSize(760, 540);
        frame.setLayout(new BorderLayout());

        String[] dias = {"Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"};

        String[] valoresIniciales = {"18", "21", "19.5", "23", "25", "22", "20"};

        JTextField[] campos = new JTextField[7];

        JPanel panelEntrada = new JPanel(new GridLayout(2, 7, 5, 5));
        panelEntrada.setBorder(BorderFactory.createEmptyBorder(10, 10, 5, 10));

        for (String dia : dias) {

            JLabel etiqueta = new JLabel(dia, SwingConstants.CENTER);
            panelEntrada.add(etiqueta);

        }

        for (int i = 0; i < 7; i++) {

            campos[i] = new JTextField(valoresIniciales[i]);
            campos[i].setHorizontalAlignment(JTextField.CENTER);
            panelEntrada.add(campos[i]);

        }

        JButton btnMostrar = new JButton("Mostrar Gráfico");

        JPanel panelBoton = new JPanel();
        panelBoton.add(btnMostrar);

        JPanel panelSuperior = new JPanel(new BorderLayout());

        panelSuperior.add(panelEntrada, BorderLayout.CENTER);
        panelSuperior.add(panelBoton, BorderLayout.SOUTH);

        PanelGraficoLineas grafico = new PanelGraficoLineas(dias);

        btnMostrar.addActionListener(e -> {

            double[] temperaturas = new double[7];

            for (int i = 0; i < 7; i++) {

                try {

                    temperaturas[i] = Double.parseDouble(campos[i].getText().trim());

                } catch (NumberFormatException ex) {

                    JOptionPane.showMessageDialog(frame, "Ingrese una temperatura válida para " +
                    dias[i] + ".");

                    campos[i].requestFocus();

                    return;

                }

            }

            grafico.setTemperaturas(temperaturas);

        });

        frame.add(panelSuperior, BorderLayout.NORTH);
        frame.add(grafico, BorderLayout.CENTER);

        frame.setVisible(true);

    }

}

class PanelGraficoLineas extends JPanel {

    private String[] dias;
    private double[] temperaturas;

    public PanelGraficoLineas(String[] dias) {

        this.dias = dias;
        setBackground(Color.WHITE);

    }

    public void setTemperaturas(double[] temperaturas) {

        this.temperaturas = temperaturas;
        repaint();

    }

    @Override
    protected void paintComponent(Graphics g) {

        super.paintComponent(g);

        Graphics2D g2d = (Graphics2D) g;

        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        int margenIzquierdo = 60;
        int margenDerecho = 30;
        int margenSuperior = 40;
        int margenInferior = 70;

        int ancho = getWidth() - margenIzquierdo - margenDerecho;
        int alto = getHeight() - margenSuperior - margenInferior;

        int[] xs = new int[7];

        for (int i = 0; i < 7; i++) {

            xs[i] = margenIzquierdo + (int) ((i + 0.5) * ancho / 7.0);

        }

        g2d.setColor(Color.BLACK);
        g2d.setFont(new Font("SansSerif", Font.BOLD, 15));
        g2d.drawString("Temperaturas de la semana (°C)", margenIzquierdo, 25);

        g2d.setFont(new Font("SansSerif", Font.PLAIN, 12));
        g2d.setStroke(new BasicStroke(2f));

        g2d.drawLine(margenIzquierdo, margenSuperior, margenIzquierdo, margenSuperior + alto);

        g2d.drawLine(margenIzquierdo, margenSuperior + alto, margenIzquierdo + ancho,
        margenSuperior + alto);

        for (int i = 0; i < 7; i++) {

            g2d.drawString(dias[i], xs[i] - 22, margenSuperior + alto + 20);

        }

        if (temperaturas == null) {

            g2d.setColor(Color.GRAY);

            g2d.drawString("Ingrese las temperaturas y presione \"Mostrar Gráfico\"",
            margenIzquierdo + 40, margenSuperior + alto / 2);

            return;

        }

        double minimo = temperaturas[0];
        double maximo = temperaturas[0];

        int diaMin = 0;
        int diaMax = 0;

        double suma = 0;

        for (int i = 0; i < 7; i++) {

            if (temperaturas[i] < minimo) {

                minimo = temperaturas[i];
                diaMin = i;

            }

            if (temperaturas[i] > maximo) {

                maximo = temperaturas[i];
                diaMax = i;

            }

            suma += temperaturas[i];

        }

        double promedio = suma / 7;
        double rango = maximo - minimo;

        if (rango == 0) {

            rango = 1;

        }

        double limiteInferior = minimo - rango * 0.15;
        double limiteSuperior = maximo + rango * 0.15;

        double rangoEscala = limiteSuperior - limiteInferior;

        Stroke punteado = new BasicStroke(1f, BasicStroke.CAP_BUTT, BasicStroke.JOIN_MITER, 10f,
        new float[]{4f}, 0f);

        for (int k = 0; k <= 4; k++) {

            double valor = limiteInferior + rangoEscala * k / 4;

            int yGuia = margenSuperior + (int) ((limiteSuperior - valor) / rangoEscala * alto);

            g2d.setColor(Color.LIGHT_GRAY);
            g2d.setStroke(punteado);

            g2d.drawLine(margenIzquierdo, yGuia, margenIzquierdo + ancho, yGuia);

            g2d.setColor(Color.DARK_GRAY);

            g2d.drawString(String.format("%.1f", valor), 15, yGuia + 4);

        }

        int[] ys = new int[7];

        for (int i = 0; i < 7; i++) {

            ys[i] = margenSuperior + (int) ((limiteSuperior - temperaturas[i]) / rangoEscala *
            alto);

        }

        g2d.setColor(new Color(231, 76, 60));

        g2d.setStroke(new BasicStroke(2.5f, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));

        g2d.drawPolyline(xs, ys, 7);

        for (int i = 0; i < 7; i++) {

            g2d.setColor(new Color(192, 57, 43));

            g2d.fillOval(xs[i] - 5, ys[i] - 5, 10, 10);

            g2d.setColor(Color.BLACK);

            g2d.drawString(String.format("%.1f °C", temperaturas[i]), xs[i] - 20, ys[i] - 10);

        }

        g2d.setColor(new Color(40, 40, 120));

        g2d.drawString(
            "Máx: " + String.format("%.1f", maximo) + " °C (" + dias[diaMax] + ") | "
            + "Mín: " + String.format("%.1f", minimo) + " °C (" + dias[diaMin] + ") | "
            + "Promedio: " + String.format("%.2f", promedio) + " °C",
            margenIzquierdo, margenSuperior + alto + 50
        );

    }

}
