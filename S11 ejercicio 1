package laboratorio11;

import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

// ============================================================
// EJERCICIO 1: Sistema de Notificaciones (Patrón Observer)
// ============================================================

// 1. La Interfaz Observer
interface Observador {
    void actualizar(Notificacion notificacion);
}

// Clase Notificación (El mensaje que viaja)
class Notificacion {
    private String tipo; // "Promoción", "Actualización", etc.
    private String mensaje;

    public Notificacion(String tipo, String mensaje) {
        this.tipo = tipo;
        this.mensaje = mensaje;
    }

    public String getTipo() { return tipo; }
    public String getMensaje() { return mensaje; }

    @Override
    public String toString() {
        return "[" + tipo.toUpperCase() + "] " + mensaje;
    }
}

// 2. El Sujeto (Subject) - La Tienda o Central de Notificaciones
class CentralDeNotificaciones {
    private List<Observador> suscriptores = new ArrayList<>();

    // Suscribir
    public void suscribir(Observador o) {
        if (!suscriptores.contains(o)) {
            suscriptores.add(o);
            System.out.println("Suscripción exitosa.");
        } else {
            System.out.println("Ya estás suscrito.");
        }
    }

    // Desuscribir
    public void desuscribir(Observador o) {
        if (suscriptores.remove(o)) {
            System.out.println("Te has dado de baja de las notificaciones.");
        } else {
            System.out.println("No estabas suscrito.");
        }
    }

    // Notificar a todos
    public void enviarNotificacion(Notificacion n) {
        if (suscriptores.isEmpty()) {
            System.out.println("No hay usuarios suscritos para notificar.");
            return;
        }
        System.out.println("\nEnviando notificación a " + suscriptores.size() + " usuario(s)...");
        for (Observador o : suscriptores) {
            o.actualizar(n);
        }
    }
    
    public int getCantidadSuscriptores() {
        return suscriptores.size();
    }
}

// 3. El Observador Concreto (Usuario)
class Usuario implements Observador {
    private String nombre;

    public Usuario(String nombre) {
        this.nombre = nombre;
    }

    public String getNombre() { return nombre; }

    @Override
    public void actualizar(Notificacion notificacion) {
        // Aquí el usuario recibe el mensaje de forma automática
        System.out.println("  -> " + nombre + " recibió: " + notificacion.toString());
    }
    
    @Override
    public String toString() {
        return nombre;
    }
}

// 4. Clase Principal (Menú Interactivo)
public class ejercicio1 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        CentralDeNotificaciones central = new CentralDeNotificaciones();
        
        // Creamos algunos usuarios de prueba
        Usuario u1 = new Usuario("Ana");
        Usuario u2 = new Usuario("Luis");
        Usuario u3 = new Usuario("María");
        
        int opcion = 0;

        while (opcion != 6) {
            System.out.println("\n=========================================");
            System.out.println("   SISTEMA DE NOTIFICACIONES (OBSERVER)");
            System.out.println("=========================================");
            System.out.println("Suscriptores actuales: " + central.getCantidadSuscriptores());
            System.out.println("-----------------------------------------");
            System.out.println("1. Suscribir a un usuario");
            System.out.println("2. Desuscribir a un usuario");
            System.out.println("3. Enviar notificación de Promoción");
            System.out.println("4. Enviar notificación de Actualización");
            System.out.println("5. Ver usuarios registrados");
            System.out.println("6. Salir");
            System.out.print("Opción: ");
            
            try {
                opcion = scanner.nextInt();
                scanner.nextLine(); // Limpiar buffer
                
                switch (opcion) {
                    case 1:
                        System.out.print("¿A quién deseas suscribir? (Ana, Luis, María): ");
                        String nombreSuscribir = scanner.nextLine();
                        if (nombreSuscribir.equalsIgnoreCase("Ana")) {
                            central.suscribir(u1);
                        } else if (nombreSuscribir.equalsIgnoreCase("Luis")) {
                            central.suscribir(u2);
                        } else if (nombreSuscribir.equalsIgnoreCase("María")) {
                            central.suscribir(u3);
                        } else {
                            System.out.println("Usuario no encontrado.");
                        }
                        break;
                        
                    case 2:
                        System.out.print("¿A quién deseas desuscribir? (Ana, Luis, María): ");
                        String nombreDesuscribir = scanner.nextLine();
                        if (nombreDesuscribir.equalsIgnoreCase("Ana")) {
                            central.desuscribir(u1);
                        } else if (nombreDesuscribir.equalsIgnoreCase("Luis")) {
                            central.desuscribir(u2);
                        } else if (nombreDesuscribir.equalsIgnoreCase("María")) {
                            central.desuscribir(u3);
                        } else {
                            System.out.println("Usuario no encontrado.");
                        }
                        break;
                        
                    case 3:
                        System.out.print("Escribe el mensaje de la promoción: ");
                        String mensajePromo = scanner.nextLine();
                        central.enviarNotificacion(new Notificacion("Promoción", mensajePromo));
                        break;
                        
                    case 4:
                        System.out.print("Escribe el mensaje de la actualización: ");
                        String mensajeAct = scanner.nextLine();
                        central.enviarNotificacion(new Notificacion("Actualización", mensajeAct));
                        break;
                        
                    case 5:
                        System.out.println("Usuarios registrados en el sistema:");
                        System.out.println(" - " + u1);
                        System.out.println(" - " + u2);
                        System.out.println(" - " + u3);
                        break;
                        
                    case 6:
                        System.out.println("Saliendo del sistema... ¡Hasta luego!");
                        break;
                        
                    default:
                        System.out.println("Opción inválida. Intente de nuevo.");
                }
            } catch (Exception e) {
                System.out.println("Error: Por favor ingrese un número válido.");
                scanner.nextLine(); // Limpiar buffer si escribió letras
                opcion = 0;
            }
        }
        scanner.close();
    }
}
