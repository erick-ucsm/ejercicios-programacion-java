package laboratorio4;

//Excepción personalizada para división por cero
class DivisionPorCeroException extends ArithmeticException {

 public DivisionPorCeroException(String mensaje) {
     super(mensaje);
 }
}


//Clase Calculadora
class Calculadora {

 public double sumar(double a, double b) {
     return a + b;
 }

 public double restar(double a, double b) {
     return a - b;
 }

 public double multiplicar(double a, double b) {
     return a * b;
 }

 public double dividir(double a, double b) {

     if (b == 0) {
         throw new DivisionPorCeroException(
             "No se puede dividir entre cero."
         );
     }

     return a / b;
 }
}


//Clase principal
public class ejercicio2 {

 public static void main(String[] args) {

     Calculadora calculadora = new Calculadora();

     try {

         double suma = calculadora.sumar(10, 5);
         System.out.println("Suma: " + suma);

         double resta = calculadora.restar(10, 5);
         System.out.println("Resta: " + resta);

         double multiplicacion = calculadora.multiplicar(10, 5);
         System.out.println("Multiplicación: " + multiplicacion);

         double division = calculadora.dividir(10, 0);
         System.out.println("División: " + division);

     } catch (IllegalArgumentException e) {

         System.out.println("Error en los argumentos: " + e.getMessage());

     } catch (ArithmeticException e) {

         System.out.println("Error matemático: " + e.getMessage());
     }
 }
}
