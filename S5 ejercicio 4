package laboratorio5;

import java.util.ArrayList;

public class ejercicio4 {

    // Clase Par reutilizada
    public static class Par<F, S> {
        private F primero;
        private S segundo;

        public Par(F primero, S segundo) {
            this.primero = primero;
            this.segundo = segundo;
        }

        @Override
        public String toString() {
            return String.format("(Primero: %s, Segundo: %s)", primero, segundo);
        }
    }

    // Clase genérica Contenedor
    public static class Contenedor<F, S> {
        private ArrayList<Par<F, S>> pares;

        public Contenedor() {
            this.pares = new ArrayList<>();
        }

        // Añadir un nuevo par
        public void agregarPar(F primero, S segundo) {
            pares.add(new Par<>(primero, segundo));
        }

        // Obtener par por índice
        public Par<F, S> obtenerPar(int indice) {
            if (indice >= 0 && indice < pares.size()) {
                return pares.get(indice);
            } else {
                throw new IndexOutOfBoundsException("Índice fuera de rango: " + indice);
            }
        }

        // Obtener todos los pares
        public ArrayList<Par<F, S>> obtenerTodosLosPares() {
            return pares;
        }

        // Mostrar todos los pares
        public void mostrarPares() {
            if (pares.isEmpty()) {
                System.out.println("El contenedor está vacío.");
            } else {
                for (int i = 0; i < pares.size(); i++) {
                    System.out.println("Par " + i + ": " + pares.get(i));
                }
            }
        }
    }

    public static void main(String[] args) {
        Contenedor<String, Integer> contenedor = new Contenedor<>();

        contenedor.agregarPar("Uno", 1);
        contenedor.agregarPar("Dos", 2);
        contenedor.agregarPar("Tres", 3);

        System.out.println("Mostrando todos los pares:");
        contenedor.mostrarPares();

        System.out.println("\nPar en índice 1: " + contenedor.obtenerPar(1));
        System.out.println("\nLista completa de pares: " + contenedor.obtenerTodosLosPares());
    }
}
